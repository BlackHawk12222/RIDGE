from typing import Any, Callable, Optional, TypeVar

_F = TypeVar("_F", bound=Callable[..., Any])

def const(expr: int) -> int: ...
def opt_level(level: Optional[int] = None) -> Optional[int]: ...
def alloc_emergency_exception_buf(size: int) -> None: ...
def mem_info(verbose: Any = None) -> None: ...
def qstr_info(verbose: Any = None) -> None: ...
def stack_use() -> int: ...
def heap_lock() -> None: ...
def heap_unlock() -> None: ...
def kbd_intr(chr: int) -> None: ...
def schedule(func: Callable[[Any], None], arg: Any) -> None: ...
def native(func: _F) -> _F: ...
def viper(func: _F) -> _F: ...